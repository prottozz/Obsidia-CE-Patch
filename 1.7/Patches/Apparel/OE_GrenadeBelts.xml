<Patch>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[@Name="OEGrenadeBeltsProjectileBase"]</xpath>
    <match Class="PatchOperationSequence">
      <operations>
    <li Class="PatchOperationAttributeSet">
        <xpath>Defs/ThingDef[@Name="OEGrenadeBeltsProjectileBase"]/projectile</xpath>
        <attribute>Class</attribute>
        <value>CombatExtended.ProjectilePropertiesCE</value>
      </li>
      </operations>
    </match>
    <nomatch Class="PatchOperationTest">
      <xpath>Defs</xpath>
    </nomatch>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="OTC_GrenadeBelt_Acid"]</xpath>
    <match Class="PatchOperationSequence">
      <operations>
    <li Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="OTC_GrenadeBelt_Acid"]/verbs</xpath>
        <value>
          <verbs>
            <li Class="CombatExtended.VerbPropertiesCE">
              <label>throw acid grenade</label>
              <verbClass>CombatExtended.Verb_LaunchProjectileStaticCE</verbClass>
              <hasStandardCommand>true</hasStandardCommand>
              <onlyManualCast>True</onlyManualCast>
              <warmupTime>1.5</warmupTime>
              <range>15.9</range>
              <minRange>3</minRange>
              <ai_IsBuildingDestroyer>true</ai_IsBuildingDestroyer>
              <soundCast>ThrowGrenade</soundCast>
              <drawHighlightWithLineOfSight>true</drawHighlightWithLineOfSight>
              <targetParams>
                <canTargetLocations>true</canTargetLocations>
              </targetParams>
              <ignorePartialLoSBlocker>true</ignorePartialLoSBlocker>
              <defaultProjectile>Grenade_GrenadeBelt_OTC_Acid</defaultProjectile>
              <rangedFireRulepack>Combat_RangedFire_Thrown</rangedFireRulepack>
            </li>
          </verbs>
        </value>
      </li>
      </operations>
    </match>
    <nomatch Class="PatchOperationTest">
      <xpath>Defs</xpath>
    </nomatch>
