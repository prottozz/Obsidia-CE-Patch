<Defs>
  <RecipeDef>
    <defName>MakeAmmo_OE_cerberus_ballistic_standard_small</defName>
    <label>make OE cerberus ballistic standard x200</label>
    <recipeUsers>
      <li>OE_WeaponWorkbench</li>
    </recipeUsers>
    <ingredients>
      <li><filter><thingDefs><li>OE_Obsidian</li></thingDefs></filter><count>8</count></li>
      <li><filter><thingDefs><li>OE_Mythril</li></thingDefs></filter><count>4</count></li>
      <li><filter><thingDefs><li>OE_AmmoKit</li></thingDefs></filter><count>2</count></li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>OE_Obsidian</li>
        <li>OE_Mythril</li>
        <li>OE_AmmoKit</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <Ammo_OE_cerberus_ballistic_standard>200</Ammo_OE_cerberus_ballistic_standard>
    </products>
  </RecipeDef>

